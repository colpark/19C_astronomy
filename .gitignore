# Third-party clones and downloaded weights. Only commit hashes are recorded, in each agent's ledgers.
astronomy/*/code/
# Source PDFs are hashed in SHA256SUMS; the extracted full text is committed instead.
astronomy/*/sources/**/*.pdf
__pycache__/
*.pyc
# Wave 2 and later: nested agent dirs
astronomy/**/code/
astronomy/**/data_cache/
astronomy/**/scratch/
astronomy/**/sources/**/*.pdf
# Opaque-id maps stay local until a rulings holder takes custody (their hashes are in transfer_record.json)
astronomy/wave2/agent5_skill_maintenance/holder_handover/
astronomy/wave3/agent5_integrity/holder_handover/
# Wave-3 cohort slice dumps (~350MB): hashed in out/SLICES_SHA256SUMS and kept local
astronomy/wave3/agent1_cohort_finish/out/w3_*_slices/
