%2BUse%2Bme%2Bover%2Bdark%2Bbackgrounds%2B-%2BRGB.png&amp;w=3840&amp;q=90" width="3201" height="477" decoding="async" loading="eager" class="sc-3133d794-0 cXlUCy"/></picture></a></div><script>$RS("S:6","P:6")</script><div hidden id="S:3"><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"For Scientists","item":"https://rubinobservatory.org/for-scientists"},{"@type":"ListItem","position":2,"name":"Survey, instruments, and telescopes","item":"https://rubinobservatory.org/for-scientists/rubin-101"},{"@type":"ListItem","position":3,"name":"Live status","item":"https://rubinobservatory.org/for-scientists/rubin-101/live-status"}]}</script><nav data-cy="breadcrumb" class="styles_breadcrumb__00Ako"><ol class="styles_list__ZqKqV"><li class="styles_item__SWTN_"><a class="styles_link__7sz0S" href="/for-scientists">For Scientists</a></li><li class="styles_item__SWTN_"><a class="styles_link__7sz0S" href="/for-scientists/rubin-101">Survey, instruments, and telescopes</a></li><li class="styles_item__SWTN_"><a class="styles_link__7sz0S" aria-current="page" href="/for-scientists/rubin-101/live-status">Live status</a></li></ol></nav><article data-sidebar="false" class="sc-e7911416-1 bRWiDx"><div><section data-testid="container" data-dark-mode="false" style="--section-background-color:var(--white);--size-padding-container:40px 0 40px" class="sc-acf01e18-0 fFTfeI"><div class="sc-acf01e18-1 NiPL c-page-header c-page-header__inner"><h1>Live status</h1><p>Date last updated: 03 Sep 2026 11:14 (MST)</p></div></section><section data-testid="container" data-dark-mode="false" style="--section-background-color:var(--transparent);--size-padding-container:40px 0 40px" class="sc-acf01e18-0 fFTfeI"><div class="sc-acf01e18-1 NiPL"><div data-cy="rich-text-content" class="styles_contentRte__pTD0X"><h2>Schedule viewer</h2>
<p>The projected Rubin schedule can be obtained via the <a href="https://usdf-rsp.slac.stanford.edu/obsloctap/skymap" target="_blank" rel="noreferrer noopener">all-sky map interface</a> or <a href="https://usdf-rsp.slac.stanford.edu/obsloctap/static/viewer.html" target="_blank" rel="noreferrer noopener">static table interface</a>.<br /></p>
<h2>Alert stream status</h2>
<p>A Grafana dashboard for the live status of the alert stream is available at <a href="https://ls.st/alert-stream-status" target="_blank" rel="noreferrer noopener">ls.st/alert-stream-status</a>.</p>
<h2>Summit all-sky</h2>
<p>The view from Cerro Pachón is available live via the <a href="https://storage.googleapis.com/epo_rubintv_data/all_sky_current/all_sky_current.jpg" target="_blank" rel="noreferrer noopener">current all-sky camera image</a>.</p>
<h2>Nightly summaries</h2>
<p>Automated per-night reports are available from the <a href="https://s3df.slac.stanford.edu/data/rubin/sim-data/schedview/reports/" target="_blank" rel="noreferrer noopener">scheduler reports</a> page by clicking "nightsum" in the table for the desired date.<br /></p></div></div></section><div class="sc-631f4fdd-0 kMeSVT"><div class="sc-7518078b-3 gNRaOH"><div class="styles_container__VuE_x"><span class="styles_localeText__kqgkX"><svg xmlns="http://www.w3.org/2000/svg" role="presentation" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" class="styles_icon__GWPg5"><path d="m12 12.7c-2.4 0-4.3-1.9-4.3-4.3s1.9-4.4 4.3-4.4 4.3 1.9 4.3 4.3c0 2.5-1.9 4.4-4.3 4.4m0-12.4c-4.4 0-8 3.6-8 8v0.2c0.1 8.8 8 15.3 8 15.3s7.9-6.5 8-15.3v-0.2c0-4.4-3.6-8-8-8"></path></svg>Chile</span><span class="styles_localeText__kqgkX" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" role="presentation" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" class="styles_icon__GWPg5"><path d="m11.8 1c-6 0-10.8 4.8-10.8 10.8s4.8 10.8 10.8 10.8 10.8-4.8 10.8-10.8-4.8-10.8-10.8-10.8zm0 19.8c-4.9 0-8.9-4-8.9-8.9s4-8.9 8.9-8.9 8.9 4 8.9 8.9c0.1 4.9-3.9 8.9-8.9 8.9z"></path><path d="m17 15.4-5.4-3.1v-5.2c0-0.4-0.3-0.6-0.6-0.6-0.4 0-0.6 0.3-0.6 0.6v5.9l6 3.4c0.1 0.1 0.2 0.1 0.3 0.1 0.2 0 0.4-0.1 0.6-0.3 0.1-0.2 0-0.6-0.3-0.8z"></path></svg>15:53 hrs</span><span class="styles_srOnly__R3Dv8">Local time: 15:53 hours</span><span class="styles_localeText__kqgkX"><svg xmlns="http://www.w3.org/2000/svg" role="presentation" viewBox="0 0 24 24" width="15" height="15" fill="currentColor" class="styles_icon__GWPg5"><path d="m6.8 4.8c0.3 0 0.6-0.3 0.6-0.6v-3.5c0-0.3-0.2-0.6-0.5-0.6s-0.6 0.2-0.7 0.5v0.1 3.6c0 0.3 0.3 0.5 0.6 0.5"></path><path d="m20.2 21.6h-16.2v-14.4h16.2v14.4zm0.6-20h-2.6v1.8c0.5 0.5 0.4 1.2 0 1.7-0.5 0.5-1.2 0.4-1.7 0-0.2-0.2-0.3-0.5-0.3-0.8s0.1-0.6 0.3-0.8v-1.9h-8.9v1.8c0.5 0.5 0.4 1.2 0 1.7-0.5 0.5-1.2 0.4-1.7 0-0.2-0.3-0.3-0.5-0.3-0.8s0.1-0.6 0.4-0.9v-1.8h-2.6c