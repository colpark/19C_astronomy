<script>
(function() {
    var clientside = window.dash_clientside = window.dash_clientside || {};
    var ns = clientside["_dashprivate_clientside_funcs"] = clientside["_dashprivate_clientside_funcs"] || {};
    ns["b3c968abd1049831908cfe49e46a6a4b8fa51b145d9cc16b431406216ace7c2e"] = 
function(n_clicks, name, apiurl){
    if(n_clicks > 0){
        fetch(apiurl + '/api/v1/sources', {
            method: 'POST',
            body: JSON.stringify({
                 'diaObjectId': name,
                 'output-format': 'json'
            }),
            headers: {
                'Content-type': 'application/json'
            }
        }).then(function(response) {
            return response.blob();
        }).then(function(data) {
            window.saveAs(data, name + '.json');
        }).catch(error => console.error('Error:', error));
    };
    return true;
}
;
})();
</script>
